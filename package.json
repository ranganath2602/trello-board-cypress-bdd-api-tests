{
  "name": "trello-board-api-tests",
  "version": "1.0.0",
  "description": "BDD API tests for the Trello Boards API using Cypress, Cucumber and TypeScript.",
  "main": "index.js",
  "scripts": {
    "cy:open:qa": "cypress open --config-file config/qa.config.ts",
    "cy:run:qa": "cypress run --spec features/**/*.feature --env tags='not @not_ready and @boards' --config-file config/qa.config.ts",
    "lint": "eslint .",
    "lint:feature": "gherkin-lint -c .gherkin-lintrc features/"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
    "cypress": "^14.0.0",
    "cypress-multi-reporters": "^2.0.5",
    "defu": "^6.1.4",
    "esbuild": "^0.25.1",
    "gherkin-lint": "^4.2.4",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.4",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-plugin-cypress": "^4.2.0"
  },
  "cypress-cucumber-preprocessor": {
    "html": {
      "enabled": true,
      "output": "./cypress/reports/report.html"
    },
    "messages": {
      "enabled": false
    },
    "stepDefinitions": "**/*.step.*"
  }
}
